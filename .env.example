# ---------------------------------------------------------------------------
# netzanalyst — copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local (docker compose). The MCP server uses the READ-ONLY user.
POSTGRES_DB=netzanalyst
POSTGRES_USER=netzanalyst
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full-privilege URL — used ONLY by the ingest scripts.
DATABASE_URL=postgresql://netzanalyst:change_me_locally@localhost:5432/netzanalyst

# Read-only URL — used by the MCP server. Separate user, SELECT only.
DATABASE_URL_READONLY=postgresql://netzanalyst_ro:change_me_locally_ro@localhost:5432/netzanalyst
POSTGRES_RO_PASSWORD=change_me_locally_ro

# --- MCP server -----------------------------------------------------------
MCP_PORT=3000
MCP_MAX_ROWS=1000
MCP_QUERY_TIMEOUT_MS=10000
ENERGY_CHARTS_BASE_URL=https://api.energy-charts.info

# --- Model provider (provider-agnostic; pick ONE) -------------------------
# MODEL_PROVIDER=azure | openai | anthropic | ollama
MODEL_PROVIDER=azure
MODEL_NAME=gpt-5.4-mini
MODEL_NAME_ANALYSIS=gpt-5.4-mini
MODEL_MAX_OUTPUT_TOKENS=2000
MODEL_REASONING_EFFORT=low

# Azure / Microsoft Foundry
AZURE_AI_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
# No key here: use `az login` + managed identity / DefaultAzureCredential.

# Non-Azure fallback so the project runs locally after the trial ends
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Observability --------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
