{
  "name": "netzanalyst-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing read-only German electricity data to netzanalyst agents",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "stdio": "node dist/index.js --stdio",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "pg": "^8.13.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0"
  }
}
